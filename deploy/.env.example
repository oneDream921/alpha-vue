# Copy this file to deploy/.env and replace every placeholder with a local value.
# Do not commit deploy/.env or reuse these example credentials outside local development.
MYSQL_DATABASE=alpha_vue
MYSQL_USER=replace-with-local-mysql-user
MYSQL_PASSWORD=replace-with-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-local-mysql-root-password
MYSQL_PORT=3306
MYSQL_URL=jdbc:mysql://localhost:3306/alpha_vue?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-redis-password
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
