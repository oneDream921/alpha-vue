# 将此文件复制为 deploy/.env，并把所有占位值替换为本地配置。
# 不得提交 deploy/.env，也不得在本地开发环境之外复用示例凭据。
MYSQL_DATABASE=alpha_vue
MYSQL_USER=replace-with-local-mysql-user
MYSQL_PASSWORD=replace-with-local-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-local-mysql-root-password
MYSQL_PORT=3306
MYSQL_URL=jdbc:mysql://localhost:3306/alpha_vue?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-local-redis-password
CAPTCHA_ENABLED=false
# 64 位十六进制 AES-256 主密钥；仅用于加密数据库中的系统设置凭据。
SYSTEM_SETTINGS_MASTER_KEY=replace-with-64-hexadecimal-characters
FILE_MAX_SIZE_BYTES=10485760
FILE_MAX_REQUEST_SIZE_BYTES=12582912
FILE_PUBLIC_ACCESS=false
FILE_ACCESS_TOKEN_SECRET=replace-with-a-random-local-file-access-secret
FILE_ACCESS_TOKEN_TTL=5m
REDIS_MASK_VALUES=true
MINIO_ROOT_USER=replace-with-local-minio-user
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
# 仅当 FILE_STORAGE_PROVIDER=minio 时后端需要以下配置。
# 请创建独立的 MinIO 应用凭据，生产环境不得复用上方 root 凭据。
MINIO_ACCESS_KEY=replace-with-minio-application-access-key
MINIO_SECRET_KEY=replace-with-minio-application-secret-key
MINIO_BUCKET=alpha-vue
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# SnailJob 为可选独立调度服务；启用 profile=snailjob 时必须替换以下本地凭据。
SNAIL_JOB_ENABLED=false
SNAIL_JOB_NAMESPACE=alpha-local
SNAIL_JOB_GROUP=alpha-vue
SNAIL_JOB_TOKEN=replace-with-snailjob-group-token
SNAIL_JOB_SERVER_HOST=localhost
SNAIL_JOB_SERVER_PORT=26888
SNAIL_JOB_CLIENT_PORT=17889
MAINTENANCE_SPRING_SCHEDULER_ENABLED=true
SNAILJOB_MYSQL_DATABASE=snail_job
SNAILJOB_MYSQL_USER=snail_job
SNAILJOB_MYSQL_PASSWORD=replace-with-snailjob-mysql-password
SNAILJOB_MYSQL_ROOT_PASSWORD=replace-with-snailjob-mysql-root-password
SNAILJOB_MYSQL_PORT=13307
SNAILJOB_HTTP_PORT=26300
