<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.onedream921.alphavue.modules.system.mapper.SysDeptMapper">
    <select id="countEnabledById" resultType="int">
        SELECT COUNT(*) FROM sys_dept WHERE id = #{id} AND deleted = 0 AND status = 1
    </select>
</mapper>
