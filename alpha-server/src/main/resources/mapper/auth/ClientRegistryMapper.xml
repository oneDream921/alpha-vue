<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.onedream921.alphavue.modules.auth.mapper.ClientRegistryMapper">
    <select id="selectEnabledByClientId" resultType="io.github.onedream921.alphavue.modules.auth.service.ClientRegistryService$Client">
        SELECT client_id, name
        FROM sys_client
        WHERE client_id = #{clientId}
          AND status = 1
          AND deleted = 0
    </select>
</mapper>
